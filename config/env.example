# ============================================================
#  ISM POS — قالب ملف البيئة (.env.example)
#  انسخ هذا الملف إلى .env ثم عدّل القيم:
#      cp config/env.example .env && php scripts/encrypt-env-helper.php
#
#  ⛔ لا تضع أبداً قيماً حقيقية هنا — هذا الملف يُرفع إلى Git
#  ⛔ الملف الفعلي .env محظور عبر .gitignore — لا تزع القاعدة أبداً
#  ⛔ بعد أي تعديل يدوي للأسرار: شغّل scripts/encrypt-env-helper.php لتشفيرها
#  لتدوير كل الأسرار دفعة واحدة: php scripts/rotate-secrets.php
# ============================================================

# ---- قاعدة البيانات ----
DB_HOST=localhost
DB_NAME=inventory_db
# استخدم مستخدماً مخصصاً بأقل صلاحيات (ism_app) بدل root — راجع خطة الإصلاح
DB_USER=ism_app
# تُكتب مشفّرة بـ AES-256-GCM بالبادئة ENC: — لا تكتبها نصاً صريحاً أبداً
# التشفير التلقائي يحدث عبر معلّم التثبيت أو scripts/encrypt-env-helper.php
DB_PASS=

# ---- مفتاح تشفير البيانات الحساسة ----
# يُستخدم لتشفير القيم الحساسة في هذا الملف (DB_PASS, DEPLOYER_SECRET, ...)
# القيم المشفرة تبدأ بـ ENC: — لا تحذف هذا المفتاح بعد التشفير أبداً!
# توليد مفتاح جديد: php -r "echo base64_encode(random_bytes(32));"
# للتدوير الكامل (مفتاح + كل الأسرار): php scripts/rotate-secrets.php
APP_ENCRYPTION_KEY=

# ---- الناشر الذري (deployer.php) ----
# رمز سري للوصول لواجهة النشر — 32+ حرفاً عشوائياً، مشفّر في .env
# توليده: php scripts/rotate-secrets.php (أو يدوياً ثم شفّره بالمساعد)
DEPLOYER_SECRET=
# عناوين IP المسموح لها بالنشر (مفصولة بفواصل) — فارغة = أي IP مع الرمز الصحيح
DEPLOYER_ALLOWED_IPS=

# ---- سياسة أمان المحتوى (CSP) ----
# false = وضع التقرير فقط | true = تنفيذ كامل (بعد التأكد من nonce في كل السكربتات)
CSP_ENFORCE=false

# ---- وضع التطوير ----
# true يعرض تفاصيل الأخطاء — ممنوع في الإنتاج نهائياً
APP_DEBUG=false
