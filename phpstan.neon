parameters:
    level: 1
    phpVersion: 80100
    paths:
        - .
    excludePaths:
        - vendor
        # أقسام توثيق API (M3): قوالب عرض جزئية تُضمَّن داخل نطاق api-docs.php
        # (متغيرات مثل $base_url معرفة في المضيف — لا معنى لتحليلها منفردة)
        - templates/api-docs
    reportUnmatchedIgnoredErrors: false
includes:
    - phpstan-baseline.neon
