<?php
require_once '../includes/bootstrap.php';
$page_title = t('products_add_new_product');
require_once __DIR__ . '/../includes/permissions.php';
requireLogin();
requirePermission('products.add');
// ❌ لا يتم تحميل header.php هنا — يتم تحميله بعد معالجة POST/AJAX
// لمنع تلوّث استجابة JSON بـ HTML عند الطلبات غير المتزامنة

$errors = [];
$success = false;

// تهيئة متغيرات الوحدة المخصصة (لمنع تحذير Undefined variable)
$custom_unit_name = '';
$custom_unit_type = 'other';
$custom_unit_conversion = 1;
$custom_unit_selling_price = 0;

// تهيئة متغيرات وحدة الشراء (لمنع تحذير Undefined variable)
$purchase_unit = '';
$purchase_unit_factor = 1;
$has_expiry = 0;

// أنواع الوحدات (للاستخدام في الحقل المخصص)
$unit_types_for_custom = [
    'quantity' => t('unit_type_quantity'),
    'weight'   => t('unit_type_weight'),
    'volume'   => t('unit_type_volume'),
    'length'   => t('unit_type_length'),
    'area'     => t('unit_type_area'),
    'other'    => t('unit_type_other'),
];

// الوحدات الأساسية حسب النوع
$base_units_by_type = [
    'quantity' => ['name' => t('base_unit_piece'), 'abbreviation' => t('abbr_piece')],
    'weight'   => ['name' => t('base_unit_kilogram'), 'abbreviation' => t('abbr_kilogram')],
    'volume'   => ['name' => t('base_unit_liter'), 'abbreviation' => t('abbr_liter')],
    'length'   => ['name' => t('base_unit_meter'), 'abbreviation' => t('abbr_meter')],
    'area'     => ['name' => t('base_unit_square_meter'), 'abbreviation' => t('abbr_square_meter')],
];

// جلب التصنيفات النشطة
$categories = [];
try {
    $categories = fetchAll("SELECT * FROM categories WHERE is_active = 1 ORDER BY sort_order ASC, name ASC");
} catch (\Throwable $e) {
    // جدول التصنيفات قد لا يكون موجوداً بعد
    ErrorHandler::logException($e, 'add-product:fetch_categories');
}

// جلب وحدات القياس النشطة
$units = [];
try {
    $units = fetchAll("SELECT * FROM measurement_units WHERE is_active = 1 ORDER BY sort_order ASC, name ASC");
} catch (\Throwable $e) {
    // جدول الوحدات قد لا يكون موجوداً بعد
    ErrorHandler::logException($e, 'add-product:fetch_measurement_units');
}

// إنشاء كود المنتج التلقائي (مع التأكد من عدم التكرار)
$next_code = 'PRD-001';
try {
    $max_num = fetchOne("SELECT MAX(CAST(SUBSTRING(code, 5) AS UNSIGNED)) as max_num FROM products WHERE code LIKE 'PRD-%'");
    if ($max_num && $max_num['max_num'] !== null) {
        $next_num = intval($max_num['max_num']) + 1;
        $next_code = 'PRD-' . str_pad($next_num, 3, '0', STR_PAD_LEFT);
    }
    // التأكد من عدم وجود الكود (حالة نادرة)
    while (fetchOne("SELECT id FROM products WHERE code = ?", [$next_code])) {
        $next_num = intval(substr($next_code, 4)) + 1;
        $next_code = 'PRD-' . str_pad($next_num, 3, '0', STR_PAD_LEFT);
    }
} catch (\Throwable $e) {
    // في حالة عدم وجود منتجات بعد
    ErrorHandler::logException($e, 'add-product:generate_next_code');
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    requireCSRF();
    // جمع البيانات - كود المنتج يتم إنشاؤه تلقائياً
    $code = trim($_POST['code'] ?? '');
    if (empty($code)) $code = $next_code;
    $name = trim($_POST['name'] ?? '');
    $purchase_price = floatval($_POST['purchase_price'] ?? 0);
    $selling_price = floatval($_POST['selling_price'] ?? 0);
    $unit = trim($_POST['unit'] ?? '');
    $purchase_unit = trim($_POST['purchase_unit'] ?? '');
    $purchase_unit_factor = floatval($_POST['purchase_unit_factor'] ?? 1);
    $quantity = floatval($_POST['quantity'] ?? 0);
    $min_quantity = floatval($_POST['min_quantity'] ?? 0);
    $category_id = !empty($_POST['category_id']) ? intval($_POST['category_id']) : null;
    $has_expiry = isset($_POST['has_expiry']) ? 1 : 0;

    // وحدة مخصصة (للوحدات الإضافية)
    $custom_unit_name = trim($_POST['custom_unit_name'] ?? '');
    $custom_unit_type = $_POST['custom_unit_type'] ?? 'other';
    $custom_unit_conversion = floatval($_POST['custom_unit_conversion'] ?? 1);
    $custom_unit_selling_price = floatval($_POST['custom_unit_selling_price'] ?? 0);

    // وحدات القياس الإضافية
    $additional_units = [];
    if (isset($_POST['au_name']) && is_array($_POST['au_name'])) {
        for ($i = 0; $i < count($_POST['au_name']); $i++) {
            $au_name = trim($_POST['au_name'][$i] ?? '');
            $au_factor = floatval($_POST['au_factor'][$i] ?? 1);
            $au_price = floatval($_POST['au_price'][$i] ?? 0);
            // معالجة اختيار "أخرى" في القائمة
            $au_custom_name = trim($_POST['au_custom_name'][$i] ?? '');
            if ($au_name === '__custom__') {
                if (!empty($au_custom_name)) {
                    $au_name = $au_custom_name;
                } else {
                    continue;
                }
            }
            if (!empty($au_name) && $au_factor > 0) {
                $additional_units[] = [
                    'name' => $au_name,
                    'factor' => $au_factor,
                    'price' => $au_price
                ];
            }
        }
    }

    // وحدات الشراء الإضافية
    $purchase_additional_units = [];
    if (isset($_POST['pau_name']) && is_array($_POST['pau_name'])) {
        for ($i = 0; $i < count($_POST['pau_name']); $i++) {
            $pau_name = trim($_POST['pau_name'][$i] ?? '');
            $pau_factor = floatval($_POST['pau_factor'][$i] ?? 1);
            $pau_custom_name = trim($_POST['pau_custom_name'][$i] ?? '');
            if ($pau_name === '__custom__') {
                if (!empty($pau_custom_name)) {
                    $pau_name = $pau_custom_name;
                } else {
                    continue;
                }
            }
            if (!empty($pau_name) && $pau_factor > 0) {
                $purchase_additional_units[] = ['name' => $pau_name, 'factor' => $pau_factor];
            }
        }
    }

    // إضافة الوحدة المخصصة كوحدة إضافية
    if (!empty($custom_unit_name) && $custom_unit_conversion > 0) {
        $additional_units[] = [
            'name' => $custom_unit_name,
            'factor' => $custom_unit_conversion,
            'price' => $custom_unit_selling_price
        ];
    }

    // التحقق من البيانات
    if (empty($name)) $errors[] = t('products_name_required');
    if ($purchase_price <= 0) $errors[] = t('common_purchase_price_must_be_positive');
    if ($selling_price <= 0) $errors[] = t('common_selling_price_must_be_positive');
    if ($purchase_price > 0 && $selling_price > 0 && $selling_price < $purchase_price) $errors[] = sprintf(t('selling_price_cannot_be_less_than_purchase'), number_format($selling_price, 2), number_format($purchase_price, 2));
    if (empty($unit)) $errors[] = t('unit_required');
    if ($quantity < 0) $errors[] = t('common_quantity_cannot_be_negative');
    if (!empty($custom_unit_name) && $custom_unit_conversion <= 0) $errors[] = t('conversion_must_be_positive');

    // Validate expiry dates if has_expiry is enabled
    $expiry_dates = [];
    if ($has_expiry && $quantity > 0) {
        $expiry_dates_data = $_POST['expiry_date'] ?? [];
        $expiry_quantities_data = $_POST['expiry_quantity'] ?? [];
        if (!empty($expiry_dates_data)) {
            for ($i = 0; $i < count($expiry_dates_data); $i++) {
                $ed = trim($expiry_dates_data[$i] ?? '');
                $eq = floatval($expiry_quantities_data[$i] ?? 0);
                if (!empty($ed) && $eq > 0) {
                    $expiry_dates[] = ['date' => $ed, 'quantity' => $eq];
                }
            }
        }
        $total_expiry_qty = array_sum(array_column($expiry_dates, 'quantity'));
        if ($total_expiry_qty > 0 && abs($total_expiry_qty - $quantity) > 0.001) {
            $errors[] = sprintf(t('expiry_total_must_equal_quantity'), number_format($total_expiry_qty, 2), number_format($quantity, 2));
        }
    }

    // التحقق من عدم تكرار الكود - إذا كان الكود التلقائي مكرراً، نولّد كوداً جديداً
    $existing = fetchOne("SELECT id FROM products WHERE code = ?", [$code]);
    if ($existing) {
        // توليد كود فريد تلقائياً
        if (preg_match('/PRD-(\d+)/', $code, $matches)) {
            $num = intval($matches[1]);
            do {
                $num++;
                $code = 'PRD-' . str_pad($num, 3, '0', STR_PAD_LEFT);
            } while (fetchOne("SELECT id FROM products WHERE code = ?", [$code]));
        } else {
            $errors[] = t('product_code_exists');
        }
    }

    if (empty($errors)) {
        try {
            $pdo = getDBConnection();
            $pdo->beginTransaction();

            // إدراج المنتج
            $stmt = $pdo->prepare("INSERT INTO products (code, name, purchase_price, selling_price, unit, purchase_unit, purchase_unit_factor, category_id, quantity, min_quantity, has_expiry) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
            $stmt->execute([$code, $name, $purchase_price, $selling_price, $unit, $purchase_unit ?: null, $purchase_unit_factor, $category_id, $quantity, $min_quantity, $has_expiry]);
            $product_id = $pdo->lastInsertId();

            // إدراج وحدات القياس الإضافية
            try {
                $auStmt = $pdo->prepare("INSERT INTO additional_units (product_id, unit_name, conversion_factor, selling_price) VALUES (?, ?, ?, ?)");
                foreach ($additional_units as $au) {
                    $auStmt->execute([$product_id, $au['name'], $au['factor'], $au['price']]);
                }
            } catch (\Throwable $e) {
                // جدول additional_units قد لا يكون موجوداً بعد
                ErrorHandler::logException($e, 'add-product:insert_additional_units');
            }

            // إدراج وحدات الشراء الإضافية
            try {
                $pauStmt = $pdo->prepare("INSERT INTO purchase_additional_units (product_id, unit_name, conversion_factor) VALUES (?, ?, ?)");
                foreach ($purchase_additional_units as $pau) {
                    $pauStmt->execute([$product_id, $pau['name'], $pau['factor']]);
                }
            } catch (\Throwable $e) {
                // جدول purchase_additional_units قد لا يكون موجوداً بعد
                ErrorHandler::logException($e, 'add-product:insert_purchase_additional_units');
            }

            // إنشاء دفعات شراء (مع تواريخ الانتهاء إذا مُفعَّلة)
            if ($quantity > 0) {
                try {
                    $batchStmt = $pdo->prepare("INSERT INTO purchase_batches (product_id, purchase_id, original_quantity, remaining_quantity, purchase_price, purchase_date, expiry_date) VALUES (?, NULL, ?, ?, ?, CURDATE(), ?)");
                    if (!empty($expiry_dates)) {
                        // إنشاء دفعة لكل تاريخ انتهاء
                        foreach ($expiry_dates as $ed) {
                            $batchStmt->execute([$product_id, $ed['quantity'], $ed['quantity'], $purchase_price, $ed['date']]);
                        }
                    } else {
                        // دفعة واحدة بدون تاريخ انتهاء
                        $batchStmt->execute([$product_id, $quantity, $quantity, $purchase_price, null]);
                    }
                } catch (\Throwable $e) { ErrorHandler::logException($e, 'add-product:insert_purchase_batches'); }
            }

            $pdo->commit();
            $success = true;

            // إشعار إضافة منتج جديد
            try {
                AppNotification::add(NOTIF_PRODUCT, t('notif_title_new_product'), t('notif_msg_product_added', $name, $code), ['url' => '../products/view-product.php?id=' . $product_id], null, 'notif_title_new_product', 'notif_msg_product_added', ['name' => $name, 'code' => $code]);
            } catch (\Throwable $e) { ErrorHandler::logException($e, 'add-product:add_notification'); }

            // حفظ معرف المنتج للإرسال العادي (PRG)
            $created_product_id = intval($product_id);
            $created_product_code = $code;

        } catch (\Throwable $e) {
            if ($pdo->inTransaction()) $pdo->rollBack();
            error_log('Product Add Error: ' . $e->getMessage());
            $errors[] = t('products_error_adding');
        }
    }
}

// === استجابة AJAX لإنشاء المنتج ===
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_SERVER['HTTP_X_REQUESTED_WITH']) && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest') {
    header('Content-Type: application/json; charset=utf-8');
    if ($success && !empty($product_id)) {
        echo json_encode(['success' => true, 'product_id' => intval($product_id), 'code' => $code ?? ''], JSON_UNESCAPED_UNICODE);
    } else {
        echo json_encode(['success' => false, 'errors' => $errors], JSON_UNESCAPED_UNICODE);
    }
    exit;
}

// === POST-Redirect-GET: منع الإضافة المزدوجة عند التحديث ===
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $success && !empty($created_product_id)) {
    header('Location: add-product.php?created=1&id=' . $created_product_id . '&code=' . urlencode($created_product_code));
    exit;
}

// === قراءة معلمات النجاح من GET (بعد إعادة التوجيه) ===
$created_id = isset($_GET['id']) ? intval($_GET['id']) : 0;
$created_code = $_GET['code'] ?? '';
$show_success = isset($_GET['created']) && $_GET['created'] === '1' && $created_id > 0;

// ✅ تحميل header.php بعد خروج AJAX و PRG — لا يؤثر على استجابات JSON
require_once '../includes/header.php';

?>

